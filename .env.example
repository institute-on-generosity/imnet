# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public site URL (used for share links and OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Claude, for light AI assists (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Ops scripts only (npm run cleanup:uploads). Never used by the web app.
SUPABASE_SECRET_KEY=

# Set to 1 when running with the demo seed: shows a "Demo data" banner.
NEXT_PUBLIC_DEMO=
